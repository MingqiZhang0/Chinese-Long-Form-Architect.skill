{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/literary-webnovel-architect/work-result.schema.json",
  "title": "Semantic Work Result",
  "type": "object",
  "required": ["result_id", "proposal_id", "contract_version", "epoch_id", "basis", "result_kind", "authority", "status", "dependency_refs", "freshness", "extensions"],
  "properties": {
    "result_id": {"type": "string", "minLength": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "contract_version": {"const": "1.0.0"},
    "epoch_id": {"type": "string", "minLength": 1},
    "basis": {
      "type": "object",
      "required": ["branch", "epoch_revision", "dependency_fingerprint", "security_domain"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "epoch_revision": {"type": "string", "minLength": 1},
        "dependency_fingerprint": {"type": "string", "minLength": 1},
        "security_domain": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "result_kind": {"enum": ["observation", "analysis", "validation", "context_derivative", "candidate_delta", "warning"]},
    "authority": {"enum": ["noncanonical", "advisory", "validation", "delta_proposal"]},
    "status": {"enum": ["complete", "partial", "unsupported", "degraded", "nonconvergent"]},
    "dependency_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "freshness": {"enum": ["fresh", "epoch_stale", "semantic_stale", "reusable"]},
    "artifact_ref": {"type": ["string", "null"]},
    "semantic_digest": {"type": ["string", "null"]},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9_.:-]+$"},
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

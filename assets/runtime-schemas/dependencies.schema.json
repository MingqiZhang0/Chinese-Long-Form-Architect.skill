{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/literary-webnovel-architect/dependencies.schema.json",
  "title": "Narrative Runtime Dependency Graph",
  "type": "object",
  "required": ["schema_version", "edges"],
  "properties": {
    "schema_version": {"type": "string"},
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "kind", "status"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "strength": {"enum": ["hard", "soft", "advisory"]},
          "status": {"enum": ["active", "retired", "invalidated"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/literary-webnovel-architect/event.schema.json",
  "title": "Narrative Runtime Event",
  "type": "object",
  "required": [
    "event_id",
    "branch",
    "seq",
    "event_type",
    "intent",
    "effects"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "event_version": {
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "story_time": {},
    "chapter": {},
    "scene": {},
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op",
          "path"
        ],
        "properties": {
          "op": {
            "enum": [
              "set",
              "delete",
              "append",
              "add_to_set",
              "remove_from_set",
              "increment"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "source": {},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transaction_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "compensates": {
      "type": "string"
    },
    "supersedes": {
      "type": "string"
    },
    "reversibility": {},
    "authority": {
      "type": "string"
    },
    "audit_closed": {
      "type": "boolean"
    },
    "transaction_identity_version": {
      "const": "1.0.0"
    },
    "transaction_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "version",
        "authority",
        "class",
        "origin_ref",
        "temporal_scope"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "authority": {
          "enum": [
            "canonical",
            "explicit_planning",
            "user_confirmed",
            "imported",
            "deterministic",
            "migration"
          ]
        },
        "class": {
          "enum": [
            "manuscript",
            "planning",
            "user_confirmed",
            "imported",
            "derived",
            "migration"
          ]
        },
        "origin_ref": {
          "type": "string",
          "minLength": 1
        },
        "temporal_scope": {
          "type": "object",
          "required": [
            "axis",
            "domain",
            "from"
          ],
          "properties": {
            "axis": {
              "enum": [
                "story_valid",
                "presentation",
                "revision"
              ]
            },
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "from": {
              "type": "number"
            },
            "until": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "derived_from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "derived"
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "required": [
              "derived_from",
              "rule_version"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "authority"
            ],
            "properties": {
              "authority": {
                "const": "canonical"
              }
            }
          },
          {
            "required": [
              "audit_closed"
            ],
            "properties": {
              "audit_closed": {
                "const": true
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "provenance"
        ]
      }
    }
  ]
}

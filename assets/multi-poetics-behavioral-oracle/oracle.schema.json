{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multi-poetics-oracle.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_id",
    "language",
    "task_type",
    "refs",
    "targeted_local_defect",
    "must_preserve",
    "allowed_interventions",
    "forbidden_interventions",
    "deterministic_assertions",
    "model_evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "task_type": {
      "enum": ["light-revision", "planning", "chapter", "drafting"]
    },
    "refs": {
      "type": "object",
      "required": [
        "input",
        "task",
        "project_poetics",
        "positive_control",
        "wrong_poetics_mutant"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "targeted_local_defect": {
      "type": "string",
      "minLength": 1
    },
    "must_preserve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "allowed_interventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "forbidden_interventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "intervention_class",
          "description",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "intervention_class": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "deterministic_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "regex_absent",
              "regex_present",
              "contains_all",
              "contains_any",
              "char_ratio",
              "paragraph_count"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "pattern": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "model_evaluation": {
      "type": "object",
      "required": [
        "pointwise_questions",
        "pairwise_question",
        "tie_policy"
      ],
      "properties": {
        "pointwise_questions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "pairwise_question": {
          "type": "string"
        },
        "tie_policy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "required": [
        "id",
        "description",
        "critical"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "critical": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

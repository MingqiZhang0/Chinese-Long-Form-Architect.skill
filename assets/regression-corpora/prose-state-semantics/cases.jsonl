{"case_id": "S01", "category": "direct-knowledge", "input": {"sources": {"prose": "陈越展开密信，逐字读完：今夜子时，开东闸。\n他把这句话记在心里，准备按信行事。"}, "state": {}}, "expected": {"claims": [{"target": "陈越知道密信内容", "layer": "actor_knowledge", "holder": "陈越", "mode": "assertion", "truth": "established", "polarity": "affirmed", "acquisition": "seen", "value": "今夜子时，开东闸", "evidence": [{"source": "prose", "start_line": 1, "end_line": 2, "quote": "陈越展开密信，逐字读完：今夜子时，开东闸。\n他把这句话记在心里，准备按信行事。"}]}], "state_findings": [], "impacts": []}}
{"case_id": "S02", "category": "hearsay-not-knowledge", "input": {"sources": {"prose": "门房说墙里藏着一封密信。陈越只听说有信，没有见过，也不知内容。"}, "state": {"陈越": {"读过密信": true}}}, "expected": {"claims": [{"target": "陈越听到密信传闻", "layer": "world", "holder": null, "mode": "assertion", "truth": "established", "polarity": "affirmed", "acquisition": "heard", "value": true, "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "门房说墙里藏着一封密信。陈越只听说有信，没有见过，也不知内容。"}]}], "state_findings": [{"pointer": "/陈越/读过密信", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "门房说墙里藏着一封密信。陈越只听说有信，没有见过，也不知内容。"}]}], "impacts": []}}
{"case_id": "S03", "category": "lie-with-established-contrary-world", "input": {"sources": {"prose": "密信仍在夹墙里。门房却对陈越说：“早烧成灰了。”陈越信了，将搜信的人手撤回。"}, "state": {"密信": {"已烧毁": true}}}, "expected": {"claims": [{"target": "密信位置", "layer": "world", "holder": null, "mode": "assertion", "truth": "established", "polarity": "affirmed", "acquisition": "none", "value": "夹墙", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "密信仍在夹墙里。门房却对陈越说：“早烧成灰了。”陈越信了，将搜信的人手撤回。"}]}, {"target": "陈越相信密信已烧毁", "layer": "actor_belief", "holder": "陈越", "mode": "lie", "truth": "refuted", "polarity": "affirmed", "acquisition": "heard", "value": true, "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "密信仍在夹墙里。门房却对陈越说：“早烧成灰了。”陈越信了，将搜信的人手撤回。"}]}], "state_findings": [{"pointer": "/密信/已烧毁", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "密信仍在夹墙里。门房却对陈越说：“早烧成灰了。”陈越信了，将搜信的人手撤回。"}]}], "impacts": []}}
{"case_id": "S04", "category": "unverified-speech-not-proven-lie", "input": {"sources": {"prose": "门房说：“信已经烧了。”陈越看着他，没说信，也没说不信。没有人知道信此刻在哪。"}, "state": {"密信": {"已烧毁": true}, "陈越": {"相信信已烧毁": true}}}, "expected": {"claims": [], "state_findings": [{"pointer": "/密信/已烧毁", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "门房说：“信已经烧了。”陈越看着他，没说信，也没说不信。没有人知道信此刻在哪。"}]}, {"pointer": "/陈越/相信信已烧毁", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "门房说：“信已经烧了。”陈越看着他，没说信，也没说不信。没有人知道信此刻在哪。"}]}], "impacts": []}}
{"case_id": "S05", "category": "conjecture-can-motivate-action", "input": {"sources": {"prose": "门房或许拿走了信。陈越猜着，却把这个念头当成唯一的解释，命人盯住门房。"}, "state": {"门房": {"拿走密信": true}}}, "expected": {"claims": [{"target": "陈越怀疑门房拿走密信", "layer": "actor_belief", "holder": "陈越", "mode": "conjecture", "truth": "unknown", "polarity": "affirmed", "acquisition": "inferred", "value": true, "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "门房或许拿走了信。陈越猜着，却把这个念头当成唯一的解释，命人盯住门房。"}]}], "state_findings": [{"pointer": "/门房/拿走密信", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "门房或许拿走了信。陈越猜着，却把这个念头当成唯一的解释，命人盯住门房。"}]}], "impacts": []}}
{"case_id": "S06", "category": "metaphor-not-injury", "input": {"sources": {"prose": "那句冷话是一把刀，扎进了陈越胸口。他站着没动，呼吸仍平稳。"}, "state": {"陈越": {"胸口刀伤": true}}}, "expected": {"claims": [], "state_findings": [{"pointer": "/陈越/胸口刀伤", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "那句冷话是一把刀，扎进了陈越胸口。他站着没动，呼吸仍平稳。"}]}], "impacts": []}}
{"case_id": "S07", "category": "counterfactual-not-actual-history", "input": {"sources": {"prose": "若那晚陈越读过密信，此刻就不会守错闸口。他其实连信封也没碰过。"}, "state": {"陈越": {"读过密信": true}}}, "expected": {"claims": [], "state_findings": [{"pointer": "/陈越/读过密信", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "若那晚陈越读过密信，此刻就不会守错闸口。他其实连信封也没碰过。"}]}], "impacts": []}}
{"case_id": "S08", "category": "misidentification-two-truth-layers", "input": {"sources": {"prose": "陈越将雨中那人认作师父，跟着进了巷子。那其实是披着师父旧袍的门房。"}, "state": {"雨中人": {"身份": "师父"}}}, "expected": {"claims": [{"target": "雨中人身份", "layer": "world", "holder": null, "mode": "assertion", "truth": "established", "polarity": "affirmed", "acquisition": "none", "value": "门房", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "陈越将雨中那人认作师父，跟着进了巷子。那其实是披着师父旧袍的门房。"}]}, {"target": "陈越相信雨中人是师父", "layer": "actor_belief", "holder": "陈越", "mode": "misidentification", "truth": "refuted", "polarity": "affirmed", "acquisition": "seen", "value": true, "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "陈越将雨中那人认作师父，跟着进了巷子。那其实是披着师父旧袍的门房。"}]}], "state_findings": [{"pointer": "/雨中人/身份", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "陈越将雨中那人认作师父，跟着进了巷子。那其实是披着师父旧袍的门房。"}]}], "impacts": []}}
{"case_id": "S09", "category": "attempt-not-transfer", "input": {"sources": {"prose": "阿宁伸手去接钥匙，陈越却缩回手，仍将钥匙攥在掌中。"}, "state": {"钥匙": {"持有人": "阿宁"}}}, "expected": {"claims": [], "state_findings": [{"pointer": "/钥匙/持有人", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "阿宁伸手去接钥匙，陈越却缩回手，仍将钥匙攥在掌中。"}]}], "impacts": []}}
{"case_id": "S10", "category": "quiet-durable-custody-omitted", "input": {"sources": {"prose": "陈越没再解释，把钥匙压进阿宁掌心。阿宁收进贴身口袋，转身走了。"}, "state": {}}, "expected": {"claims": [{"target": "钥匙持有人", "layer": "world", "holder": null, "mode": "assertion", "truth": "established", "polarity": "affirmed", "acquisition": "none", "value": "阿宁", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "陈越没再解释，把钥匙压进阿宁掌心。阿宁收进贴身口袋，转身走了。"}]}], "state_findings": [{"pointer": "/钥匙/持有人", "status": "omitted", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "陈越没再解释，把钥匙压进阿宁掌心。阿宁收进贴身口袋，转身走了。"}]}], "impacts": []}}
{"case_id": "S11", "category": "within-scene-reversal-net-exit-state", "input": {"sources": {"prose": "陈越把钥匙交给阿宁；阿宁摇头，又将它塞回陈越手中。散席时钥匙仍在陈越兜里。"}, "state": {"钥匙": {"持有人": "阿宁"}}}, "expected": {"claims": [], "state_findings": [{"pointer": "/钥匙/持有人", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "陈越把钥匙交给阿宁；阿宁摇头，又将它塞回陈越手中。散席时钥匙仍在陈越兜里。"}]}], "impacts": []}}
{"case_id": "S12", "category": "future-intention-not-completion", "input": {"sources": {"prose": "“等天亮，我就把钥匙给你。”陈越说完，把钥匙锁进了自己的抽屉。"}, "state": {"钥匙": {"持有人": "阿宁"}}}, "expected": {"claims": [{"target": "钥匙位置", "layer": "world", "holder": null, "mode": "assertion", "truth": "established", "polarity": "affirmed", "acquisition": "none", "value": "陈越的抽屉", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "“等天亮，我就把钥匙给你。”陈越说完，把钥匙锁进了自己的抽屉。"}]}], "state_findings": [{"pointer": "/钥匙/持有人", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "“等天亮，我就把钥匙给你。”陈越说完，把钥匙锁进了自己的抽屉。"}]}], "impacts": []}}
{"case_id": "S13", "category": "negation-scope-object-identity", "input": {"sources": {"prose": "陈越没有看见密信烧毁；他看见的是门房将一张空白纸扔进炉里。"}, "state": {"密信": {"已烧毁": true}}}, "expected": {"claims": [], "state_findings": [{"pointer": "/密信/已烧毁", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "陈越没有看见密信烧毁；他看见的是门房将一张空白纸扔进炉里。"}]}], "impacts": []}}
{"case_id": "S14", "category": "seen-object-not-read-content", "input": {"sources": {"prose": "陈越看见了折好的密信，却没有展开。外封没有一个字。"}, "state": {"陈越": {"知道信中时刻": "子时"}}}, "expected": {"claims": [{"target": "陈越知道密信存在", "layer": "actor_knowledge", "holder": "陈越", "mode": "assertion", "truth": "established", "polarity": "affirmed", "acquisition": "seen", "value": true, "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "陈越看见了折好的密信，却没有展开。外封没有一个字。"}]}], "state_findings": [{"pointer": "/陈越/知道信中时刻", "status": "unsupported", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "陈越看见了折好的密信，却没有展开。外封没有一个字。"}]}], "impacts": []}}
{"case_id": "S15", "category": "free-indirect-certainty-not-omniscience", "input": {"sources": {"prose": "准是门房拿走了。还能有谁？陈越攥紧拳头。信其实被阿宁收在袖里。"}, "state": {}}, "expected": {"claims": [{"target": "密信持有人", "layer": "world", "holder": null, "mode": "assertion", "truth": "established", "polarity": "affirmed", "acquisition": "none", "value": "阿宁", "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "准是门房拿走了。还能有谁？陈越攥紧拳头。信其实被阿宁收在袖里。"}]}, {"target": "陈越相信门房拿走密信", "layer": "actor_belief", "holder": "陈越", "mode": "conjecture", "truth": "refuted", "polarity": "affirmed", "acquisition": "inferred", "value": true, "evidence": [{"source": "prose", "start_line": 1, "end_line": 1, "quote": "准是门房拿走了。还能有谁？陈越攥紧拳头。信其实被阿宁收在袖里。"}]}], "state_findings": [], "impacts": []}}
{"case_id": "S16", "category": "revision-independent-and-unindexed-support", "input": {"sources": {"before": "陈越从夹墙中取出密信，展开，认出了师父惯用的三角收笔。\n信上写着：今夜子时，开东闸。\n他把密信重新藏回墙里。\n", "ch17": "师父留下的练字纸还在。陈越摊开它，将三角形的收笔照着描了一遍。\n", "ch23": "陈越将练字纸与登记簿并排，凭相同的三角收笔认出了师父的笔迹。\n密信里明明写的是今夜子时，开东闸。他还记得在夹墙前亲眼读过的那一行字。\n因此，他撤掉西闸的人手，全部调往东闸。\n", "ch24": "审问时，陈越指出密信第二行缺了一个字；那是他在夹墙前读信时发现的。\n", "ch8": "陈越只听门房说，夹墙里藏着一封密信。\n门房没有说信中写了什么，他也没有去看。\n他把铜钥匙交给阿宁，阿宁收进贴身口袋。\n"}, "state": {}, "dependencies": {"branch": "main", "edges": [{"source": "CH8:seen-letter", "target": "CH23:recognition", "kind": "knowledge-source"}, {"source": "CH17:independent-sample", "target": "CH23:recognition", "kind": "knowledge-source"}, {"source": "CH8:seen-letter", "target": "CH23:content", "kind": "knowledge-source"}, {"source": "CH23:content", "target": "CH23:gate-action", "kind": "action-premise"}, {"source": "CH8:seen-letter", "target": "experiment:recognition", "kind": "knowledge-source", "branch": "experiment"}, {"source": "CH8:seen-letter", "target": "retired:claim", "kind": "knowledge-source", "status": "retired"}]}, "revision": {"before": "before", "after": "ch8", "branch": "main"}}, "expected": {"claims": [], "state_findings": [], "impacts": [{"node": "CH23:content", "status": "affected", "evidence": [{"source": "ch23", "start_line": 2, "end_line": 2, "quote": "密信里明明写的是今夜子时，开东闸。他还记得在夹墙前亲眼读过的那一行字。"}]}, {"node": "CH23:gate-action", "status": "affected", "evidence": [{"source": "ch23", "start_line": 2, "end_line": 3, "quote": "密信里明明写的是今夜子时，开东闸。他还记得在夹墙前亲眼读过的那一行字。\n因此，他撤掉西闸的人手，全部调往东闸。"}]}, {"node": "CH23:recognition", "status": "independent", "evidence": [{"source": "ch23", "start_line": 1, "end_line": 1, "quote": "陈越将练字纸与登记簿并排，凭相同的三角收笔认出了师父的笔迹。"}]}, {"node": "CH24:missing-character", "status": "affected", "evidence": [{"source": "ch24", "start_line": 1, "end_line": 1, "quote": "审问时，陈越指出密信第二行缺了一个字；那是他在夹墙前读信时发现的。"}]}]}}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/literary-webnovel-architect/prose-state-reconciliation.schema.json",
  "title": "Prose-State Reconciliation Report",
  "type": "object",
  "required": [
    "reconciliation_version",
    "chapter_id",
    "branch",
    "prose_path",
    "prose_sha256",
    "prose_candidates",
    "state_deltas",
    "status"
  ],
  "properties": {
    "reconciliation_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "chapter_id": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "prose_path": {
      "type": "string",
      "minLength": 1
    },
    "prose_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY_FOR_REVIEW",
        "APPROVED",
        "REJECTED"
      ]
    },
    "prose_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "description",
          "disposition",
          "delta_ids"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "committed",
              "non_durable",
              "rejected",
              "pending"
            ]
          },
          "delta_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          },
          "semantics": {
            "type": "object",
            "required": [
              "mode",
              "layer",
              "proposition",
              "polarity",
              "truth",
              "acquisition",
              "evidence",
              "rationale"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "assertion",
                  "report",
                  "lie",
                  "conjecture",
                  "metaphor",
                  "counterfactual",
                  "misidentification",
                  "intention"
                ]
              },
              "layer": {
                "enum": [
                  "world",
                  "actor_belief",
                  "actor_knowledge",
                  "reader_exposure"
                ]
              },
              "holder": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "proposition": {
                "type": "string",
                "minLength": 1
              },
              "polarity": {
                "enum": [
                  "affirmed",
                  "negated",
                  "unknown"
                ]
              },
              "truth": {
                "enum": [
                  "established",
                  "refuted",
                  "unknown",
                  "not_applicable"
                ]
              },
              "acquisition": {
                "enum": [
                  "seen",
                  "heard",
                  "inferred",
                  "none"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "rationale": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "state_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "delta_id",
          "description",
          "basis",
          "evidence"
        ],
        "properties": {
          "delta_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string"
          },
          "before": {},
          "after": {},
          "basis": {
            "enum": [
              "prose",
              "offscreen-simulation",
              "author-decision",
              "research-correction",
              "runtime-derived"
            ]
          },
          "basis_note": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "start_line",
                "end_line",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "layer": {
            "enum": [
              "world",
              "actor_belief",
              "actor_knowledge",
              "reader_exposure"
            ]
          },
          "holder": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "semantic_review": {
      "type": "object",
      "required": [
        "coverage",
        "sources"
      ],
      "properties": {
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "evidence",
              "candidate_ids",
              "status",
              "rationale"
            ],
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence"
              },
              "candidate_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "status": {
                "enum": [
                  "pending",
                  "reviewed"
                ]
              },
              "rationale": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "state_snapshot": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "branch"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "state_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pointer",
              "value",
              "status",
              "evidence",
              "rationale"
            ],
            "properties": {
              "pointer": {
                "type": "string"
              },
              "value": {},
              "status": {
                "enum": [
                  "pending",
                  "supported",
                  "unsupported",
                  "non_prose",
                  "non_material"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "rationale": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "rollover_receipt": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "finalization_id": {
          "type": "string",
          "minLength": 1
        },
        "input_final_prose_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "state_snapshot_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "state_snapshot_id"
          ],
          "additionalProperties": false
        },
        "verification": {
          "const": "VERIFIED"
        },
        "effect": {
          "enum": [
            "REVIEWED_STATE",
            "FORMAT_ONLY_NO_STATE_DELTA"
          ]
        },
        "formatting_proof": {
          "type": "object",
          "properties": {
            "previous_finalization_id": {
              "type": "string",
              "minLength": 1
            },
            "previous_reconciliation_id": {
              "type": "string",
              "minLength": 1
            },
            "normalized_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "classification": {
              "enum": [
                "SAME_BYTES",
                "FORMAT_ONLY"
              ]
            }
          },
          "required": [
            "previous_finalization_id",
            "previous_reconciliation_id",
            "normalized_sha256",
            "classification"
          ],
          "additionalProperties": false
        },
        "report_source": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "project_id",
        "finalization_id",
        "input_final_prose_sha256",
        "snapshot",
        "verification",
        "effect"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "const": "FORMAT_ONLY_NO_STATE_DELTA"
              }
            }
          },
          "then": {
            "required": [
              "formatting_proof"
            ]
          },
          "else": {
            "required": [
              "report_source"
            ]
          }
        }
      ]
    },
    "reconciliation_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "start_line",
        "end_line",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reconciliation_version": {
            "const": "1.1.0"
          }
        },
        "required": [
          "reconciliation_version"
        ],
        "not": {
          "properties": {
            "rollover_receipt": {
              "properties": {
                "effect": {
                  "const": "FORMAT_ONLY_NO_STATE_DELTA"
                }
              },
              "required": [
                "effect"
              ]
            }
          },
          "required": [
            "rollover_receipt"
          ]
        }
      },
      "then": {
        "required": [
          "semantic_review"
        ],
        "properties": {
          "prose_candidates": {
            "items": {
              "required": [
                "semantics"
              ]
            }
          },
          "state_deltas": {
            "items": {
              "required": [
                "layer"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "rollover_receipt"
        ]
      },
      "then": {
        "required": [
          "reconciliation_id"
        ]
      }
    }
  ]
}

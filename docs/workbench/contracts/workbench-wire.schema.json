{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clfa:workbench:wire:1.0.0",
  "title": "Workbench bootstrap and isolated spike read profile",
  "description": "Existing bootstrap preserved; spike numeric story-time read profile. Not a complete production contract.",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/SuccessResponse"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    },
    {
      "$ref": "#/$defs/SnapshotEvent"
    }
  ],
  "$defs": {
    "ProjectId": {
      "type": "string",
      "minLength": 1,
      "x-id-type": "ProjectId"
    },
    "SnapshotId": {
      "type": "string",
      "minLength": 1,
      "x-id-type": "SnapshotId"
    },
    "CharacterId": {
      "type": "string",
      "minLength": 1,
      "x-id-type": "CharacterId"
    },
    "FactId": {
      "type": "string",
      "minLength": 1,
      "x-id-type": "FactId"
    },
    "EvidenceId": {
      "type": "string",
      "minLength": 1,
      "x-id-type": "EvidenceId"
    },
    "AnchorId": {
      "type": "string",
      "minLength": 1,
      "x-id-type": "AnchorId"
    },
    "IssueId": {
      "type": "string",
      "minLength": 1,
      "x-id-type": "IssueId"
    },
    "ProjectToken": {
      "type": "string",
      "minLength": 1,
      "x-id-type": "ProjectToken"
    },
    "LeaseId": {
      "type": "string",
      "minLength": 1,
      "x-id-type": "LeaseId"
    },
    "Version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": true
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "BROKEN_EVIDENCE",
            "STALE_SNAPSHOT",
            "PROJECT_NOT_FOUND",
            "SCHEMA_MISMATCH",
            "UNSUPPORTED_PROTOCOL",
            "ENGINE_UNAVAILABLE",
            "AGENT_UNAVAILABLE",
            "QUERY_INCOMPLETE",
            "LEASE_EXPIRED",
            "CANCELLED",
            "DEADLINE_EXCEEDED",
            "BUSY",
            "INVALID_REQUEST",
            "INTERNAL_ERROR"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "validation",
            "compatibility",
            "availability",
            "query",
            "cancellation",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "validation"
                },
                "validation_path": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "validation_path",
                "expected"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "object_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "snapshot_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnapshotId"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "engine",
            "client"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "reason_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "suggested_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "legacy_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "category",
        "message",
        "retryable",
        "details",
        "object_refs",
        "snapshot_id",
        "origin"
      ],
      "additionalProperties": true
    },
    "Hello": {
      "type": "object",
      "properties": {
        "selected_version": {
